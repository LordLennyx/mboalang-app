{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "backgroundImage": { "url": "${imageRight}", "fillMode": "cover", "horizontalAlignment": "right" },
  "minHeight": "140px",
  "verticalContentAlignment": "center",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": 62,
          "verticalContentAlignment": "center",
          "items": [
            { "type": "TextBlock", "text": "${headline}", "size": "extraLarge", "weight": "bolder", "color": "light", "wrap": true },
            { "type": "TextBlock", "text": "${meaning}", "color": "light", "wrap": true, "maxLines": 2, "spacing": "small" },
            { "type": "TextBlock", "text": "${message}", "color": "light", "size": "small", "isSubtle": true, "wrap": true, "spacing": "small" }
          ]
        },
        { "type": "Column", "width": 38 }
      ]
    }
  ],
  "actions": [{ "type": "Action.Execute", "title": "${open}", "verb": "open" }]
}

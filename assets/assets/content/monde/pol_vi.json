null],["Halo, jesteś jeszcze?","Xin chào, bạn còn đó không?",null],["Jeden, dwa, trzy, cztery, pięć, sześć, siedem, osiem, dziewięć, dziesięć.","Một, hai, ba, bốn, năm, sáu, bảy, tám, chín, mười.",null],["Chcesz jeden?","Cần một cái không?",null],["Muszę iść.","Phải té thôi.",null],["Zrób coś.","Làm gì đi.",null],["Zrób to.","Làm đi.",null],["Pomóżcie nam.","Giúp chúng tôi với.",null],["Co zrobiłeś?","Bạn đã tạo ra cái gì rồi ?",null],["Pomogę ci.","Tôi sẽ giúp bạn.",null],["Kim jestem?","Tôi là ai?",null],["Wiesz, kim jestem?","Bạn có biết tôi là ai không?",null],["Wie pan, kim jestem?","Bạn có biết tôi là ai không?",null],["Byliśmy inni.","Chúng ta đều khác nhau.",null],["Za drogo!","Đắt quá!",null],["Nikt nie wiedział","Không ai biết.",null],["My już wiemy.","Chúng ta đều đã biết.",null],["Nikt nie wie.","Không ai biết.",null],["Nikt nic nie widział.","Chẳng ai thấy gì cả.",null],["Gdzie jest problem?","Vấn đề ở đâu",null],["Zaraz wrócę.","Tôi sẽ sớm trở lại",null],["Skąd jesteś?","Bạn từ đâu đến?",null],["Nadal to robię.","Tôi vẫn làm thế.",null],["Oni są sami.","Họ cô đơn.",null],["On dużo je.","Anh ấy ăn nhiều.",null],["Mam rodzinę.","Tôi có gia đình.",null],["To bracia.","Họ là anh em trai.",null],["Mam przyjaciół.","Tôi có bạn bè.",null],["Są braćmi?","Họ là anh em đúng không?",null],["Są siostrami?","Họ là chị em đúng không?",null],["Każdy wie.","Ai cũng biết.",null],["Och, przepraszam.","ồ tôi xin lỗi",null],["Lubię cię.","Tớ thích cậu.",null],["Muszę jechać.","Phải té thôi.",null],["Sprawdźcie to.","Xem cái kia đi.",null],["Muszę iść spać.","tôi phải đi ngủ",null],["Mów poważnie.","Nghiêm túc đi.",null],["Dobry wieczór!","Chào buổi tối.",null],["Za późno.","Quá muộn",null],["Zobaczymy się później.","Hẹn gặp lại bạn nhé.",null],["Co one mi zrobią?","Họ định sẽ làm gì tôi đây?",null],["Widzieliśmy ich ostatniej nocy.","Tôi thấy họ tối qua.",null],["Idź prosto.","Đi thẳng.",null],["Żaden problem.","Điều đó không vấn đề.",null],["Idź na zewnątrz.","Ra ngoài đi.",null],["Czekaliśmy na zewnątrz.","Chúng tôi chờ bên ngoài.",null],["Nie lubię żadnego z nich.","Tôi không thích cả hai.",null],["Nie zrozumiałem.","Tôi không hiểu.",null],["Proszę, jedz.","Hãy ăn đi.",null],["Zapytaj ich.","Hỏi họ đi.",null],["Przyjdź jutro.","Ngày mai hãy đến.",null],["Przyjdź szybko!","Đến nhanh lên.",null],["Nie zrozumiałeś.","Bạn không hiểu đâu.",null],["Nie słuchaj tego człowieka.","Đừng nghe người này.",null],["Mów powoli.","Nói chậm thôi.",null],["Mów wolniej.","Hãy nói chậm hơn.",null],["Zapytaj kogokolwiek.","Hỏi ai đó đi.",null],["Jedź ostrożnie.","Lái cẩn thận vào.",null],["Proszę, mów wolniej!","Làm ơn hãy nói chậm lại.",null],["Przyszedłeś za wcześnie.","Bạn tới sớm quá.",null],["Znasz odpowiedź?","bạn có biết đáp án không?",null],["Brak mi słów.","Tôi hết lời để nói.",null],["Jestem lekarzem.","Tôi là bác sĩ.",null],["Do ataku!","Tấn công!",null],["Nie jestem lekarzem.","Tôi không phải là bác sĩ.",null],["Złap mnie.","Bắt tôi đi.",null],["Przygotujcie się.","Chuẩn bị đi.",null],["Przygotuj się.","Chuẩn bị đi.",null],["Wierzę ci.","Tôi tin bạn.",null],["Kupię samochód.","Tôi sẽ mua một chiếc ô tô.",null],["Nie mam samochodu.","Tôi không có ô tô.",null],["To jest woda.","Đó là nước.",null],["Jestem na światłach.","Tôi đang ở chỗ đèn giao thông.",null],["Nie mamy wody.","Chúng ta không có nước.",null],["Szczęśliwego Nowego Roku!","Chúc mừng năm mới!",null],["Masz nóż?","Bạn có dao không?",null],["Zapomniałem zamknąć okna.","Tôi quên đóng cửa sổ.",null],["To jest niespodzianka.","Thật ngạc nhiên",null],["Jesteście głodni?","Mọi người đói chưa?",null],["Jesteśmy głodni.","Chúng tôi đói.",null],["Bądźcie silne.","Mạnh mẽ lên.",null],["Byłem zadowolony.","Tôi hài lòng.",null],["Jestem zmęczona.","Tôi mệt",null],["Jesteś głodny?","Bạn có đói không?",null],["Jestem zmęczony.","Tôi mệt",null],["Skup się.","Chú ý đi.",null],["Muszę odpocząć.","Tôi cần phải nghỉ ngơi.",null],["Napijesz się czegoś?","Bạn có muốn thức uống gì không?",null],["Jaka cena?","Giá cả bao nhiêu?",null],["Nie ma dziś wiatru.","Hôm nay đéo có gió.",null],["Myślę, że mam teorię na ten temat.","Tôi nghĩ là tôi có lý thuyết về điều đó",null],["Proszę zwolnić!","Chậm lại đi!",null],["Śpiewaj nadal.","Cứ hát tiếp đi.",null],["Czy lubisz śpiewać?","Bạn thích hát không?",null],["Muszę wziąć prysznic.","Tôi cần đi tắm.",null],["Lubisz deszcz, prawda?","Các bạn thích mưa nhỉ.",null],["Mam rower.","Tôi có một chiếc xe đạp.",null],["Autobus jest pusty.","Xe buýt không có ai cả.",null],["Mam kota.","Tôi có một con mèo.",null],["Mam białego kota.","Tôi có một con mèo trắng.",null],["Nie mam kota.","Tôi không có mèo.",null],["Ptak jest na niebie.","Con chim ở trên trời.",null],["Lubię gotować.","Tôi thích nấu ăn.",null],["Lubisz gotować?","Bạn có thích nấu ăn không?",null],["Co gotujesz?","Mẹ đang nấu gì đấy?",null]],"dishes":{"woda":"eau","mleko":"lait","kawa":"café","herbata":"thé","chleb":"pain","jajko":"œuf"}}
u.","O bir çocuktan başka bir şey değil.",null],["Yeye ni mwanafunzi mzuri.","O iyi bir öğrenci.",null],["Walikuwa na mtoto mmoja tu.","Onların sadece bir çocuğu vardı.",null],["Je, mna njaa?","Aç mısın?",null],["Habari za asubuhi?","Bu sabah nasılsınız?",null],["Je, huna mkutano?","Senin toplantın yok mu?",null],["Sitaki kwenda shule.","Okula gitmek istemiyorum.",null],["Sisi ni wanafunzi.","Biz öğrenciyiz.",null],["Je, unataka chakula?","Yiyecek istiyor musun?",null],["Mvulana anataka kujua ukweli.","Oğlan, gerçeği bilmek istiyor.",null],["Mwanamke anataka kujua ukweli.","Kadın, gerçeği bilmek istiyor.",null],["Mtu anataka kujua ukweli.","Adam, gerçeği bilmek istiyor.",null],["Msichana anataka kujua ukweli.","Kız, gerçeği bilmek istiyor.",null],["\"Je, unataka kujua?\" \"Kila kitu.\"","\"Ne bilmek istiyorsun?\" \"Her şeyi.\"",null],["Elimu ni muhimu.","Eğitim önemlidir.",null],["Watoto ni maua ya maisha yetu.","Çocuklar hayatlarımızın çiçekleridir.",null],["Je! Kuna mto popote karibu na hapa?","Buraya yakın bir yerde bir nehir var mı?",null],["Uko tayari?","Hazır mısın?",null],["Nina kompyuta.","Benim bir bilgisayarım var.",null],["Hiyo ni siri?","Bu bir sır mı?",null],["Chokoleti hii ni tamu sana na ina ladha.","Bu çikolata çok tatlı ve lezzetli.",null],["Mimi si daktari.","Ben bir doktor değilim.",null],["Yeye hana moyo hata kidogo.","Onun hiç kalbi yok.",null],["Tuna shida kubwa kwenye mikono yetu.","Ellerimizde büyük bir sorunumuz var.",null],["Mdomo wa chini ni mkubwa kuliko mdomo wa juu.","Alt dudak, üst dudaktan daha büyüktür.",null],["Bei gani?","Fiyatı nedir?",null],["Mimi si mwimbaji.","Şarkıcı değilim.",null],["Yeye ni mwimbaji.","O bir şarkıcı.",null],["Mimi ni mwalimu.","Ben bir öğretmenim.",null],["Yeye ni mwalimu wangu.","O, benim öğretmenimdir.",null],["Ni bei nzuri kwa kweli","O gerçekten iyi bir fiyat.",null],["Je,hii ni ya thamani?","Bu değerli midir?",null],["Ahadi ni deni.","Bir söz bir borçtur.",null],["Nina baiskeli.","Bir bisikletim var.",null],["Mvulana ana farasi.","Oğlanın bir atı var.",null],["Samaki, tafadhali","Balık, lütfen.",null],["Nina paka.","Kedim var.",null],["Ninataka kwenda uvuvi.","Balığa gitmek istiyorum.",null],["Papa ana kula samaki","Köpek balıkları balık yer.",null],["Hii paka ni yangu.","Bu benim kedim.",null],["We, bwana! Kula paka wangu, tafadhali!","Hey bayım! Kedimi yiyin, lütfen!",null],["Ninataka mkate.","Ekmek istiyorum.",null],["Kuna ndizi?","Hiç muz var mı?",null],["Rafiki yangu anataka sukari.","Arkadaşım şeker istiyor.",null],["Tangi ni tupu.","Tank boş.",null],["Siagi ni tamu, chungwa ni kali ... na ni nini chungu?","Şeker tatlıdır, limon ekşidir, peki acı nedir?",null],["Sakafu ni baridi.","Zemin soğuk.",null]],"dishes":{"maji":"eau","chokoleti":"chocolat","samaki":"poisson","kuku":"poulet","mkate":"pain","kahawa":"café","keki":"gâteau","chai":"thé","ndizi":"banane","tufaha":"pomme","siagi":"beurre","asali":"miel"}}
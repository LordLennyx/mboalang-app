 поблизости есть река?",null],["Nina kompyuta.","У меня есть компьютер.",null],["Hiyo ni siri?","Это тайна?",null],["Chokoleti hii ni tamu sana na ina ladha.","Этот шоколад очень сладкий и вкусный.",null],["Yeye ni daktari.","Она врач.",null],["Mimi si daktari.","Я не врач.",null],["Yeye hana moyo hata kidogo.","У него совсем нет сердца.",null],["Bei gani?","Какова цена?",null],["Mimi si mwimbaji.","Я не певец.",null],["Yeye ni mwimbaji.","Она певица.",null],["Mimi ni mwalimu.","Я учитель.",null],["Ni bei nzuri kwa kweli","Это на самом деле хорошая цена.",null],["Je,hii ni ya thamani?","Это представляет ценность?",null],["Nina baiskeli.","У меня есть велосипед.",null],["Mvulana ana farasi.","У мальчика есть лошадь.",null],["Una simu nyumbani.","У вас в доме есть телефон.",null],["Maktaba ni upande wa kulia.","Библиотека находится справа.",null],["Samaki, tafadhali","Рыбу, пожалуйста.",null],["Nina paka.","У меня есть кот.",null],["Ninataka kwenda uvuvi.","Я хочу пойти на рыбалку.",null],["Papa ana kula samaki","Акулы едят рыбу.",null],["Hii paka ni yangu.","Это мой кот.",null],["We, bwana! Kula paka wangu, tafadhali!","О, уважаемый! Съешьте, пожалуйста, мою кошку!",null],["Ninataka mkate.","Я хочу хлеб.",null],["Kuna ndizi?","Есть бананы?",null],["Sakafu ni baridi.","Пол холодный.",null],["Nguvu ya jua ni chanzo safi cha nishati.","Солнечная энергия - источник чистой энергии.",null],["Opera unaanza saa saba.","Опера начинается в семь.",null]],"dishes":{"maji":"eau","chokoleti":"chocolat","samaki":"poisson","mkate":"pain","kahawa":"café","nyama":"viande","chai":"thé","supu":"soupe","tufaha":"pomme","chumvi":"sel"}}
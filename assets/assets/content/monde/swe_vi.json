väll.","Chào buổi tối.",null],["Hjälp mig!","Cứu tôi!",null],["Vad gjorde du i går kväll?","Tối hôm qua bạn làm gì?",null],["De åkte.","Họ đã rời đi.",null],["Stanna här.","Hãy ở đây đi.",null],["Stanna där.","Cứ ở đấy đi.",null],["Det är vårt.","Đó là của chúng ta.",null],["Jag är verkligen ledsen!","Tôi vô cùng xin lỗi.",null],["Jag gör det fortfarande.","Tôi vẫn làm thế.",null],["Vem talar jag med?","Tôi đang nói chuyện với ai",null],["Jag kan bara tala för mig.","Tôi chỉ có thể nói cho chính mình thôi.",null],["Lyssna inte på den här mannen.","Đừng nghe người này.",null],["Han är ensam.","Anh ta sống một mình.",null],["Hon är redo.","Cô ấy sẵn sàng",null],["Var redo.","Chuẩn bị đi.",null],["Jag känner mig ensam.","Tôi cảm thấy cô đơn.",null],["Det är för att du inte vill vara ensam.","Đó là vì bạn không muốn đơn độc.",null],["Jag är hemma.","Tôi đang ở nhà.",null],["Är någon hemma?","Có ai ở nhà không?",null],["Känn er som hemma.","Xin bạn hãy cứ tự nhiên như ở nhà.",null],["Vänta utanför.","Chờ ở ngoài đi.",null],["Vilka pratade ni med?","Bạn đã nói chuyện với ai?",null],["Vilka pratade du med?","Bạn đã nói chuyện với ai?",null],["God natt.","Chúc ngủ ngon.",null],["Var är maten?","Đồ ăn đâu?",null],["De förstod.","Họ đã hiểu.",null],["Skriv till mig.","Viết cho tôi đi.",null],["Vi förstår.","Chúng tôi hiểu mà.",null],["Jag förstår inte.","Tôi không hiểu.",null],["Jag vill gifta mig med henne.","Tôi muốn lấy cô ấy.",null],["Hon var ung.","Cô ấy khi đó còn trẻ.",null],["Ingen är perfekt.","Không ai hoàn hảo cả.",null],["Jag är trött.","Tôi mệt",null],["Håll käften!","Im miệng!",null],["Slåss inte.","Đừng đánh nhau.",null],["Ingen bor här.","Không ai sống ở đây cả.",null],["Var bor ni?","Bạn sống ở đâu?",null],["Jag vann.","Tôi đã thắng.",null],["Bor du här?","Bạn có sống ở đây không?",null],["Bor ni här?","Bạn có sống ở đây không?",null],["Var bor du?","Bạn sống ở đâu?",null],["Jag vill äta glass.","Tôi muốn ăn kem.",null],["Jag är döv.","Tôi bị điếc.",null]],"dishes":{"ett vatten":"eau","ett kaffe":"café","en mjölk":"lait","en ost":"fromage"}}
ξω.","Chờ ở ngoài đi.",null],["Περίμενε εδώ.","Chờ ở đây nhé.",null],["Την αγαπάω.","Tôi yêu cô ấy.",null],["Πάρε μια απόφαση!","Hãy quyết định đi!",null],["Έχω ένα όνειρο.","Tôi có ước mơ.",null],["Ξέρεις την απάντηση;","Bạn có biết đáp án là gì không?",null],["Κάνει κρύο.","Lạnh.",null],["Δεν έχω άλογο.","Tôi không có ngựa.",null],["Είδα ένα σκυλί.","Tôi thấy một con chó.",null],["Έχω μια γάτα.","Tôi có một con mèo.",null],["Πού είναι ο γάτος;","Con mèo ở đâu?",null],["Που πήγε το άλογο;","Con ngựa đã đi đâu?",null],["Έχω δύο γάτες.","Tôi có hai con mèo.",null],["Αυτός είναι ο γάτος μου.","Đây là mèo của tôi.",null],["Είσαι όμορφος.","Bạn đẹp quá.",null],["Είσαι ελεύθερη απόψε;","Tối nay bạn có rảnh không?",null],["Είμαι ομορφότερος από σας.","Tôi đẹp hơn bạn.",null],["Έχεις φάει;","Bạn đã ăn chưa?",null],["Θα μάθω.","Tôi sẽ học.",null],["Παρακολουθώ τηλεόραση.","Tôi đang coi ti vi.",null],["Πιες κάτι.","Uống gì đó đi.",null],["Τρώω ένα μήλο.","Tôi đang ăn một quả táo.",null]],"dishes":{"το νερό":"eau","το τσάι":"thé","το γάλα":"lait","το ψάρι":"poisson","το ψωμί":"pain","ο καφές":"café","το μήλο":"pomme"}}
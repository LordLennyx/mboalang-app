ng cô ta sẽ tới.",null],["一人でいるよ。","Anh ta sống một mình.",null],["彼は質問に答えた。","Anh trả lới câu hỏi.",null],["君は答えがわかるって？","bạn có biết đáp án không?",null],["簡単、簡単。","Quá dễ.",null],["完璧だ！","Hoàn hảo!",null],["素敵な考えね。","Một ý tưởng đáng yêu.",null],["幸せって何だ？","Hạnh phúc là gì?",null],["俺は自由な男。","Tôi là một người đàn ông tự do.",null],["彼はとても正直だ。","Anh ấy rất thành thật.",null],["私の仕事簡単だと思う？","Bạn có nghĩ là công việc của tôi dễ dàng không?",null],["私の責任？","Đấy là lỗi của tôi á?",null],["最近どう？","Dạo này bạn thế nào?",null],["ゆっくり、ゆっくり。","Đi chậm thôi.",null],["友人は少しいる。","Tớ có một vài người bạn.",null],["彼は僕の親友だ。","Anh ấy là một người bạn rất gần gũi.",null],["彼女は教師だ。","Cô ấy là một giáo viên.",null],["学校の前で待ってるよ。","Tôi sẽ đợi bạn ở phía trước của trường.",null],["後悔するよ。","Bạn sẽ hối hận về điều đó.",null],["コーヒーできたぞ。","Cà phê được rồi.",null],["勉強するな。","Đừng học nữa.",null],["私は昨日勉強する必要は無かった。","Tôi đã không đi học ngày hôm qua.",null],["私は無実だ。","Tôi vô tội!",null],["彼女は親切だ。","Cô ấy là một người tốt bụng.",null],["彼女は私のタイプだ。","Cô ấy là mẫu người của tôi.",null],["お返事ありがとう。","Cảm ơn bạn đã phản hồi.",null],["これが最もベストな方法だ。","Đây chính là phương pháp tốt nhất.",null],["そう深刻に考えるな。","Đừng suy nghĩ quá nghiêm túc như thế!",null],["翻訳する。","Dịch.",null],["やっと金曜日だ。","Cuối cùng cũng tới thứ 6 rồi.",null],["明日は月曜よ。","Hôm qua là thứ Hai.",null],["また、月曜日ね。","Gặp lại bạn vào thứ Hai nhé.",null],["月曜日で大丈夫？","Thứ hai OK không?",null],["昨日は月曜日だった。","Hôm qua là thứ Hai.",null],["幸福って何？","Hạnh phúc là gì?",null],["クレジットカードの番号は？","Số thẻ tín dụng của bạn là gì?",null]],"dishes":{"コーヒー":"café","パン":"pain","チーズ":"fromage","チョコレート":"chocolat","ミルク":"lait","バター":"beurre","ジュース":"jus","オレンジ":"orange","バナナ":"banane","林檎":"pomme"}}
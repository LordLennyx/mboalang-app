akafu ni baridi.","床は冷たい。",null]],"dishes":{"maji":"eau","chokoleti":"chocolat","samaki":"poisson","mkate":"pain","kahawa":"café","nyama":"viande","keki":"gâteau","ndizi":"banane"}}